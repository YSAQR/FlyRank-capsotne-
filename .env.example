# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_USER=flyrank
POSTGRES_PASSWORD=flyrank_dev_password
POSTGRES_DB=flyrank_billing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://flyrank:flyrank_dev_password@localhost:5432/flyrank_billing

# Development-only tenant identity (NOT production authentication).
# Clients must send:
#   X-Tenant-Id: <tenant uuid>
#   X-Dev-Token: <this value>
TENANT_DEV_TOKEN=change-me-dev-token

# Public URLs used by Stripe Checkout
PUBLIC_BASE_URL=http://localhost:8000
CHECKOUT_SUCCESS_URL=http://localhost:8000/docs?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:8000/docs?checkout=cancel

# Demo pricing version label (rates are DEMO, not a live provider price list)
PRICING_VERSION=demo-v1

# Stripe TEST MODE only. Leave placeholders for local API tests (Stripe is mocked).
# Never put live keys here. Never commit a real .env file.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRO_PRICE_ID=price_placeholder
STRIPE_API_VERSION=2024-06-20
